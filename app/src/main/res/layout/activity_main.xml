<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 软件名固定左上角 -->
        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:paddingTop="4dp"
            android:text="AA2CarLife"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- 状态及以下内容整体下移 -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="130dp" />

        <TextView
            android:id="@+id/status_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:text="@string/status_idle"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_main_connect"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="18dp"
            android:text="@string/btn_connect_main"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="4dp"
            android:text="@string/hint_need_carlife"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/hint_extra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="2dp"
            android:textColor="#B06A00"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:paddingBottom="4dp"
            android:text="高级选项"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 高级选项：常显，按类别分组 -->
        <LinearLayout
            android:id="@+id/advanced_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- ===== 显示 ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="2dp"
                android:text="显示"
                android:textSize="15sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/chk_show_preview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:saveEnabled="false"
                android:checked="false"
                android:text="显示画面预览"
                android:textSize="14sp" />

            <FrameLayout
                android:id="@+id/preview_frame"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="4dp"
                android:background="#000000">

                <com.hobby.aa2carlife.ui.PreviewLayout
                    android:id="@+id/surface_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:clickable="true"
                    android:focusable="true">

                    <TextureView
                        android:id="@+id/preview_texture"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </com.hobby.aa2carlife.ui.PreviewLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/hint_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/hint_video_landscape"
                android:textSize="10sp" />

            <CheckBox
                android:id="@+id/chk_local_audio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:saveEnabled="false"
                android:checked="false"
                android:text="播放劫持声音（本机）"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/chk_test_pattern"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chk_test_pattern"
                android:textSize="14sp" />

            <!-- ===== 车机 ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:paddingBottom="2dp"
                android:text="车机"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_clear_display_profile"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="清除分辨率记忆"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="8dp"
                    android:text="本机蓝牙地址"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/edit_bt_mac"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:hint="@string/hint_bt_mac"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_save_bt_mac"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/btn_save_bt_mac"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- ===== 日志 ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:paddingBottom="2dp"
                android:text="日志"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="新日志不会自动滚动；点右下角 ↓ 到最底部"
                android:textSize="10sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="170dp">

                <ScrollView
                    android:id="@+id/log_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#11000000">

                    <TextView
                        android:id="@+id/log_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:padding="4dp"
                        android:textSize="9sp" />
                </ScrollView>

                <Button
                    android:id="@+id/btn_log_bottom"
                    android:layout_width="56dp"
                    android:layout_height="44dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="6dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="↓"
                    android:textSize="22sp" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>